# Осы файлды `.env` деп көшіріп, мәндерін толтырыңыз.
# Supabase → Project Settings → API бетінен алынады.
#
# anon key құпия ЕМЕС — қауіпсіздік RLS арқылы қамтамасыз етіледі.
# `service_role` кілтін бұл файлға ЕШҚАШАН жазбаңыз: ол RLS-ті айналып өтеді
# әрі EXPO_PUBLIC_ префиксі бар айнымалылар бандлға түгел кіреді.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
