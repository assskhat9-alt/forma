{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    // node --test типтерді алып тастап тікелей .ts файлын іске қосады,
    // сондықтан тесттегі импорт нақты кеңейтіммен жазылады.
    "allowImportingTsExtensions": true,
    // Expo базасы `customConditions: ["react-native"]` қояды, ол @types/node-ты
    // автоматты таппай қалады. Тест файлдары `node:test` импорттайды.
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "design"]
}
