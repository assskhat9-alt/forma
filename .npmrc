# Expo SDK 57 react@19.2.3-ті дәл бекітеді, ал expo-router өзінің веб бөлігі үшін
# react-dom@19.2.8-ті тартады (radix, vaul, @expo/metro-runtime). Нативте ол код
# мүлде іске қосылмайды, бірақ npm-ның қатаң peer тексерісі орнатуды тоқтатады.
#
# `npx expo install --check` «Dependencies are up to date» дейді — яғни нұсқалар
# SDK үшін дұрыс. Сондықтан react-ты көтермей, peer тексерісін жұмсартамыз.
legacy-peer-deps=true
